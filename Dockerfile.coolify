FROM wordpress:php8.2-apache@sha256:c960c894c6e26cc16974b98cc638053e2fd8be0acec5a61d39b56b0bde87878d

# Seed inicial del sitio (WordPress + themes + plugins + uploads)
COPY . /usr/src/wordpress/

# Forzamos que el contenedor genere wp-config.php desde variables de entorno
RUN rm -f /usr/src/wordpress/wp-config.php \
 && chown -R www-data:www-data /usr/src/wordpress
